import Foundation

// ===============================
// MARK: - API Models
// ===============================

struct GameResponse: Codable {
    let results: [GameAPI]
}

struct GameAPI: Codable, Identifiable {
    let id: Int
    let name: String
    let backgroundImage: String?
    let released: String?

    enum CodingKeys: String, CodingKey {
        case id
        case name
        case released
        case backgroundImage = "background_image"
    }
}

// ===============================
// MARK: - Error Handling
// ===============================

enum NetworkError: Error, LocalizedError {
    case invalidURL
    case invalidResponse
    case decodingError
    case serverError

    var errorDescription: String? {
        switch self {
        case .invalidURL:
            return "Invalid URL."
        case .invalidResponse:
            return "Invalid server response."
        case .decodingError:
            return "Failed to decode data."
        case .serverError:
            return "Server error."
        }
    }
}

// ===============================
// MARK: - API Service
// ===============================

struct APIService {

    private let baseURL = "https://api.rawg.io/api/games"
    private let apiKey = "527dc75467084d3db73688684ca4ebb8"

    func fetchGames() async throws -> [GameAPI] {

        guard var components = URLComponents(string: baseURL) else {
            throw NetworkError.invalidURL
        }

        components.queryItems = [
            URLQueryItem(name: "key", value: apiKey)
        ]

        guard let url = components.url else {
            throw NetworkError.invalidURL
        }

        let (data, response) = try await URLSession.shared.data(from: url)

        guard let http = response as? HTTPURLResponse,
              (200...299).contains(http.statusCode) else {
            throw NetworkError.invalidResponse
        }

        do {
            return try JSONDecoder()
                .decode(GameResponse.self, from: data)
                .results
        } catch {
            throw NetworkError.decodingError
        }
    }
}
